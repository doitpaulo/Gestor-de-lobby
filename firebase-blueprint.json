{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Nexus Project Firebase Schema",
  "entities": {
    "User": {
      "path": "users/{userId}",
      "description": "User profile data",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "avatar": { "type": "string", "optional": true },
        "role": { "type": "string", "optional": true },
        "createdAt": { "type": "string", "optional": true }
      }
    },
    "Task": {
      "path": "tasks/{taskId}",
      "description": "Tasks, automations, improvements and incident tickets",
      "fields": {
        "id": { "type": "string" },
        "summary": { "type": "string" },
        "type": { "type": "string" },
        "status": { "type": "string" },
        "priority": { "type": "string" },
        "assignee": { "type": "string", "optional": true },
        "requester": { "type": "string", "optional": true },
        "createdAt": { "type": "string", "optional": true },
        "updatedAt": { "type": "string", "optional": true },
        "hasCost": { "type": "boolean", "optional": true },
        "dispatchCount": { "type": "number", "optional": true },
        "costValue": { "type": "number", "optional": true },
        "assignedUid": { "type": "string", "optional": true },
        "allowedUids": { "type": "array", "optional": true }
      }
    },
    "WorkspaceMember": {
      "path": "users/{userId}/members/{memberId}",
      "description": "RBAC membership and demand permissions keyed by Auth UID",
      "fields": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "status": { "type": "string" },
        "assignedTaskIds": { "type": "array" },
        "linkedDevId": { "type": "string", "optional": true },
        "linkedDevName": { "type": "string", "optional": true },
        "mustChangePassword": { "type": "boolean", "optional": true },
        "tempPasswordSetAt": { "type": "number", "optional": true },
        "passwordChangedAt": { "type": "string", "optional": true },
        "provisioningMode": { "type": "string", "optional": true }
      }
    },
    "AccessRequest": {
      "path": "users/{userId}/accessRequests/{requestId}",
      "description": "Authenticated, verified-email dev onboarding request keyed by Auth UID",
      "fields": {
        "id": { "type": "string" },
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "name": { "type": "string", "optional": true },
        "department": { "type": "string", "optional": true },
        "devNameHint": { "type": "string", "optional": true },
        "status": { "type": "string" },
        "requestedAt": { "type": "string" }
      }
    },
    "Developer": {
      "path": "devs/{devId}",
      "description": "Developer team display catalog (never grants RBAC access)",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "optional": true },
        "linkedUid": { "type": "string", "optional": true },
        "linkedMemberId": { "type": "string", "optional": true }
      }
    },
    "Robot": {
      "path": "robots/{robotId}",
      "description": "RPA Bots and automation registry",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "department": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Sprint": {
      "path": "sprints/{sprintId}",
      "description": "Agile Sprints for project planning",
      "fields": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "status": { "type": "string" }
      }
    },
    "Setting": {
      "path": "settings/{settingId}",
      "description": "Application settings (workflow, document pipeline, devops)",
      "fields": {
        "id": { "type": "string" },
        "value": { "type": "any" }
      }
    },
    "Backup": {
      "path": "backups/{backupId}",
      "description": "Cloud backup snapshots",
      "fields": {
        "id": { "type": "string" },
        "timestamp": { "type": "string" },
        "reason": { "type": "string" }
      }
    }
  }
}
